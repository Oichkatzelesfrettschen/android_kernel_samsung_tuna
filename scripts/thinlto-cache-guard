#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Run one ThinLTO link and keep its cache free of results from a failed link.
#
# usage: thinlto-cache-guard CACHE_DIR COMMAND [ARGS...]
#
# LLD writes a cache entry when a module finishes native code generation. A
# codegen diagnostic (frame size over -Wframe-larger-than, an inline-asm
# error) fails the link under --fatal-warnings after the entry exists, and a
# retry that hits the entry skips codegen and exits 0 without the diagnostic.
# A link that fails therefore removes every entry it created, so each entry
# that remains came from a link that finished without a diagnostic.
# CACHE_DIR belongs to one link target; concurrent links use distinct
# directories.
set -eu

cache=${1:?cache directory}
shift
mkdir -p "$cache"
before=$(mktemp "$cache.before.XXXXXX")
after=$(mktemp "$cache.after.XXXXXX")
trap 'rm -f "$before" "$after"' EXIT

ls -A "$cache" | sort > "$before"
rc=0
"$@" || rc=$?
if [ "$rc" -ne 0 ]; then
	ls -A "$cache" | sort > "$after"
	comm -13 "$before" "$after" | while IFS= read -r entry; do
		rm -f -- "$cache/$entry"
	done
fi
exit "$rc"
